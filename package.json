{
  "name": "ejoeundental-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "audit": "node scripts/site-audit.mjs",
    "build:check": "npm run build && npm run audit",
    "build:owner": "node scripts/build-owner-library.mjs",
    "test:owner": "node scripts/test-owner-library.mjs",
    "test:owner:auth": "node --test scripts/test-owner-auth.mjs",
    "test:owner:all": "npm run test:owner && npm run test:owner:auth"
